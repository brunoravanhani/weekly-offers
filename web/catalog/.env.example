# S3 bucket URL where processed JSON files are stored
# Example: https://weekly-offers-dev-us-east-1-123456789-processed.s3.amazonaws.com
# Or CloudFront URL if prefer: https://d123abc.cloudfront.net
NEXT_PUBLIC_PROCESSED_BUCKET_URL=https://your-processed-bucket.s3.amazonaws.com

# Optional: Override the catalog index URL specifically
# If not provided, defaults to ${NEXT_PUBLIC_PROCESSED_BUCKET_URL}/data/catalog/index.json
NEXT_PUBLIC_CATALOG_INDEX_URL=https://your-processed-bucket.s3.amazonaws.com/data/catalog/index.json
